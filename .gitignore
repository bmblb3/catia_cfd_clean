*.snupkg
packages/
!packages/build/

# Test results and coverage
TestResults/
[Tt]est[Rr]esult*/
coverage*.json
*.coverage
*.coveragexml

# Rider / JetBrains
.idea/

# ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# Logs, temp and crash dumps
*.log
*.tmp
*.temp
*.bak
*.swp
*~
*.dmp
Thumbs.db
Desktop.ini

# OS-generated
.DS_Store
